{
  "expo": {
    "name": "GolMobile",
    "slug": "golmobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#04101B"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.seuapp.golmobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#04101B"
      },
      "package": "com.seuapp.golmobile"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "GolMobile",
      "shortName": "GolMobile",
      "themeColor": "#04101B",
      "backgroundColor": "#04101B",
      "display": "standalone",
      "description": "Chute, marque e leve seu time ao topo do Brasileirão."
    },
    "plugins": [
      "expo-notifications",
      "expo-font"
    ]
  }
}
