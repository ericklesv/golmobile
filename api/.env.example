DATABASE_URL=postgresql://brgol:SENHA@localhost:5432/brgol?schema=public
JWT_SECRET=troque-por-uma-chave-longa
PORT=4310
CORS_ORIGINS=https://brgol.managol.com.br
ADMIN_KEY=troque-tambem
# Opcional (testes): rodada mais curta / hora de fechamento
# ROUND_CLOSE_HOUR=19
# TOTAL_ROUNDS=30
UPLOADS_DIR=/var/www/brgol/uploads
# E-mail (recuperação de senha). Sem SMTP_HOST, o link de redefinição é só logado no console.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="JogaGol <nao-responda@jogagol.com.br>"
# URL pública do site (monta o link do e-mail: PUBLIC_WEB_URL/redefinir-senha?token=...)
PUBLIC_WEB_URL=https://jogagol.com.br
# VIP pago — PIX pela Efí (credenciais SÓ aqui no .env do servidor, nunca no git).
# Sem elas a tela do VIP mostra os pacotes com "A compra por PIX abre em breve".
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_PIX_KEY=
# certificado .p12 da Efí: em base64 (EFI_CERT_BASE64) ou o caminho do arquivo (EFI_CERT_PATH)
EFI_CERT_PATH=/var/www/brgol/efi/certificado.p12
# EFI_SANDBOX=1   # homologação (credenciais e certificado de homologação)
# segredo aleatório que vai na URL do aviso de PIX; depois: node scripts/efi-webhook.js
EFI_WEBHOOK_SECRET=
# EFI_FAKE=1 simula a Efí no PC (botão "Simular pagamento"). NUNCA no servidor (ignorado em produção).
# MODO_LIVRE=1 SÓ no PC: chutes sem recarga, sem captcha e minigames sem limite (vídeo/testes). NUNCA na VPS.
# X1_JOGO=BOTAO (ou FUTPREGO) SÓ no PC: força o jogo do X1 do dia para testar. NUNCA na VPS.
# FUTPREGO_MESMO_IP=1 SÓ no PC: deixa jogar FutPrego com duas janelas na mesma internet. NUNCA na VPS.

# Turnstile (Cloudflare, captcha invisível no cadastro) — os dois vazios = desligado
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Avisos no Telegram para o dono (mesmo bot e chat do Managol) — vazios = desligado
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
