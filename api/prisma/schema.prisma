// BRGOL — modelo de dados (PostgreSQL)
// Toda escrita de jogo passa pela API; o cliente nunca toca no banco.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Serie {
  A
  B
  C
}

enum KickKind {
  AUTO
  PENALTY
  FOUL
  TRAIL
  PARTY
  TERMO
  QUIZ
  MEMORIA
  QUALTIME
  ALVO
  STATS
  CABECAO
  CAMISAS
  HATTRICK
  FALTAPRO
  FRANGACO
  GANHAPERDE
  FUTPREGO
  BOTAO
}

enum SeasonStatus {
  ACTIVE
  FINISHED
}

enum RoundStatus {
  LIVE
  FINISHED
}

enum RecordScope {
  HOUR
  ROUND
  SEASON
}

model User {
  id           Int       @id @default(autoincrement())
  nick         String    @unique
  nickLower    String    @unique
  email        String    @unique
  passwordHash String
  gender       String    @default("M")
  bio          String?
  avatarUrl    String?   // /api/uploads/avatars/<id>.<ext>
  nickColor    String?   // cor do nick (chave da paleta em lib/items.js; habilidade "Mensagem com cores", lvl 8)
  nickFade     String?   // nick em degradê, só para VIP ativo: "<cor>><cor>" (chaves de NICK_FADE_COLORS em lib/items.js)
  isAdmin      Boolean   @default(false)
  bannedUntil  DateTime?
  createdAt    DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  lastIp       String? // último IP visto (cadastro/login/heartbeat) — painel de admin
  createdIp    String? // IP do cadastro (não muda; teto de contas por IP em 24 h — lib/security.js)
  lastIpAt     DateTime?
  // último aparelho (lib/device.js; dono, 15/09/2026): código que o site grava no navegador (igual em todas as contas
  // abertas nele — "mesmo aparelho" no painel), o nome ("Android · Chrome", "App Android") e se é celular
  deviceId     String?
  device       String?
  deviceMobile Boolean?
  // Conta excluída pelo próprio jogador (exigência da Play Store): a linha fica anonimizada
  // (nick "excluido-<id>", e-mail/senha/foto/bio/IP apagados) e não entra mais. Ver routes/account.js.
  deletedAt    DateTime?

  teamId Int
  team   Team @relation(fields: [teamId], references: [id])

  // Economia
  money     Int       @default(0) // R$ virtuais
  vipDays   Int       @default(0) // unidades de VIP no banco (1 unidade = 1 dia)
  vipUntil  DateTime?
  dexterity Int       @default(0) // LEGADO: a destreza acabou em 16/09/2026 (virou habilidade); fica 0, o dinheiro foi devolvido
  // Habilidades (dono, 16/09/2026, no modelo do BRGOL 2.0): 10 níveis cada; cada nível custa 1 ponto de nível,
  // R$ 25 mil ou 1 VIP (services/skills.js). `skillPoints` = quantos níveis foram pagos com PONTO (os pontos
  // disponíveis são nível − skillPoints).
  skillAim    Int     @default(0) // Pontaria: acerto do pênalti
  skillShot   Int     @default(0) // Chute: acerto da falta
  skillPoints Int     @default(0) // níveis pagos com ponto de nível

  // Contadores de gols (espelham a tabela Goal para leitura rápida)
  goalsTotal  Int     @default(0)
  goalsSeason Int     @default(0)
  seasonId    Int?
  goalsRound  Int     @default(0)
  roundId     Int?
  goalsHour   Int     @default(0)
  hourKey     String?

  // Pontos de nível extras (minigames diários). Nível = goalsTotal + levelBonus.
  levelBonus  Int     @default(0)
  // Recorde de sequência no minigame Estatísticas
  statsBest   Int     @default(0)

  // Estatísticas por modo (acertos / tentativas)
  autoGoals    Int @default(0)
  penaltyGoals Int @default(0)
  penaltyTries Int @default(0)
  foulGoals    Int @default(0)
  foulTries    Int @default(0)
  trailGoals   Int @default(0)
  trailTries   Int @default(0)
  partyWins    Int @default(0)
  partyTries   Int @default(0)

  // Recargas (última execução de cada modo)
  lastAutoAt    DateTime?
  lastPenaltyAt DateTime?
  lastFoulAt    DateTime?
  lastTrailAt   DateTime?

  // Corrida da trilha em andamento (layout secreto + fase)
  trailState Json?

  // Contratado por proposta: não troca de time nem aceita outra proposta até aqui (1 dia por VIP)
  contractUntil DateTime?

  // Convites: código do link (jogagol.com.br/convite/<refCode>) e quem convidou este jogador
  refCode      String?  @unique
  referredById Int?
  referredBy   User?    @relation("Referral", fields: [referredById], references: [id])
  referrals    User[]   @relation("Referral")

  goals       Goal[]
  activities  Activity[]
  nerfsGiven  Nerf[]     @relation("NerfFrom")
  nerfsTaken  Nerf[]     @relation("NerfTo")
  records     Record[]
  hourWins    HourResult[]
  dailyGames  DailyGame[]
  chatMessages ChatMessage[]
  items       UserItem[]
  shopLogs    ShopLog[]
  passwordResets PasswordReset[]
  vipPurchases VipPurchase[]
  teamRole    TeamRole?
  offersSent  TransferOffer[] @relation("OfferFrom")
  offersGot   TransferOffer[] @relation("OfferTo")
  giftsSent   VipGift[]       @relation("GiftFrom")
  giftsGot    VipGift[]       @relation("GiftTo")
  loginPasses LoginPass[]
  blocksGiven UserBlock[]     @relation("BlockFrom")
  blocksGot   UserBlock[]     @relation("BlockTo")
  reportsMade Report[]        @relation("ReportFrom")
  reportsGot  Report[]        @relation("ReportTo")
  refEarned   ReferralReward[] @relation("RefEarner")
  refRewards  ReferralReward[] @relation("RefFrom")
  adminActions AdminAction[] @relation("AdminActionBy")
  adminTargeted AdminAction[] @relation("AdminActionTo")
  messages    Message[]       @relation("MsgTo")
  messagesSent Message[]      @relation("MsgFrom")

  @@index([teamId])
  @@index([goalsTotal])
  @@index([referredById])
  @@index([createdIp, createdAt])
  @@index([deviceId])
}

// Minigames diários: 1 partida por jogador, por jogo, por dia (o dia vira à
// meia-noite de Brasília). `game` é texto para um minigame novo não pedir migração.
model DailyGame {
  id         Int       @id @default(autoincrement())
  userId     Int
  user       User      @relation(fields: [userId], references: [id])
  game       String // "TERMO"
  day        Int // nº do dia no calendário dos minigames (#1 = 12/09/2026)
  state      Json // estado do minigame (Termo: { guesses: string[] })
  won        Boolean   @default(false)
  reward     Json? // o que ganhou ao vencer (gol, pontos de nível)
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, game, day])
  @@index([game, day])
}

model Team {
  id             Int    @id @default(autoincrement())
  slug           String @unique
  name           String
  abbr           String
  state          String
  colorPrimary   String
  colorSecondary String
  colorTertiary  String? // 3ª cor (times tricolores, ex.: Santa Cruz preto/branco/vermelho) — listras no X1
  kitDesign      String    @default("classico") // desenho do uniforme escolhido pelo presidente (KIT_DESIGNS em rules.js); cores nunca mudam
  kitChangedAt   DateTime? // última troca (1 por dia — CLUB.kitChangeHours)
  stadium        String
  serie          Serie
  slogan         String?

  users       User[]
  homeMatches Match[]    @relation("HomeTeam")
  awayMatches Match[]    @relation("AwayTeam")
  standings   Standing[]
  goals       Goal[]
  titles      Title[]
  activities  Activity[]
  roles       TeamRole[]
  offers      TransferOffer[] @relation("OfferTeam")
  offersOut   TransferOffer[] @relation("OfferFromTeam")
}

// ─── Loja ───────────────────────────────────────────────────────────────────
// O catálogo de itens é estático em código (lib/items.js). Aqui só o que o
// jogador tem: item com validade (expiresAt), nível (Energia 1..5), se está
// equipado (chuteiras: só uma) e se já foi consumido (Caneleira: numa trilha).
model UserItem {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  itemKey   String // chave em lib/items.js (ENERGY, BOOST_AUTO, SHIN_GUARD, BOOT_*)
  level     Int       @default(1)
  equipped  Boolean   @default(false)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, itemKey])
  @@index([userId, expiresAt])
}

// Histórico da loja (toda compra: item, preço e moeda).
model ShopLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  itemKey   String
  price     Int
  currency  String // "money" | "vip"
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Recuperação de senha por e-mail: token de uso único (guardado como hash SHA-256) com validade.
model PasswordReset {
  id        Int       @id @default(autoincrement())
  token     String    @unique
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Season {
  id          Int          @id @default(autoincrement())
  number      Int          @unique
  startsAt    DateTime
  endsAt      DateTime?
  totalRounds Int
  status      SeasonStatus @default(ACTIVE)
  topJson     Json? // top 10 artilheiros congelado no fechamento da temporada (estatísticas de top 10 do perfil)
  x1Json      Json? // Ranking X1 da temporada congelado + prêmios pagos (services/x1.js); null = ainda não fechou

  rounds    Round[]
  standings Standing[]
  goals     Goal[]
  records   Record[]
  titles    Title[]
}

model Round {
  id       Int         @id @default(autoincrement())
  seasonId Int
  season   Season      @relation(fields: [seasonId], references: [id])
  number   Int
  startsAt DateTime
  endsAt   DateTime
  status   RoundStatus @default(LIVE)
  topJson  Json? // top 10 artilheiros congelado no fechamento
  x1Json   Json? // Ranking X1 da rodada congelado + prêmios pagos (services/x1.js); null = ainda não fechou

  matches Match[]
  goals   Goal[]

  @@unique([seasonId, number])
  @@index([status, endsAt])
}

model Match {
  id         Int         @id @default(autoincrement())
  roundId    Int
  round      Round       @relation(fields: [roundId], references: [id])
  serie      Serie
  homeTeamId Int
  homeTeam   Team        @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId Int
  awayTeam   Team        @relation("AwayTeam", fields: [awayTeamId], references: [id])
  homeGoals  Int         @default(0)
  awayGoals  Int         @default(0)
  status     RoundStatus @default(LIVE)

  goals Goal[]

  @@index([roundId])
  @@index([homeTeamId])
  @@index([awayTeamId])
}

model Standing {
  id           Int    @id @default(autoincrement())
  seasonId     Int
  season       Season @relation(fields: [seasonId], references: [id])
  teamId       Int
  team         Team   @relation(fields: [teamId], references: [id])
  serie        Serie
  points       Int    @default(0)
  played       Int    @default(0)
  wins         Int    @default(0)
  draws        Int    @default(0)
  losses       Int    @default(0)
  goalsFor     Int    @default(0)
  goalsAgainst Int    @default(0)

  @@unique([seasonId, teamId])
  @@index([seasonId, serie])
}

model Goal {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  teamId    Int
  team      Team     @relation(fields: [teamId], references: [id])
  matchId   Int?
  match     Match?   @relation(fields: [matchId], references: [id])
  roundId   Int?
  round     Round?   @relation(fields: [roundId], references: [id])
  seasonId  Int?
  season    Season?  @relation(fields: [seasonId], references: [id])
  hourKey   String
  kind      KickKind
  money     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([hourKey, userId])
  @@index([roundId, userId])
  @@index([seasonId, userId])
  @@index([userId, kind])
  @@index([createdAt])
}

model Activity {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  teamId    Int
  team      Team     @relation(fields: [teamId], references: [id])
  kind      KickKind
  goal      Boolean
  text      String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([teamId, createdAt])
}

model HourResult {
  id           Int      @id @default(autoincrement())
  hourKey      String   @unique
  closedAt     DateTime @default(now())
  winnerUserId Int?
  winner       User?    @relation(fields: [winnerUserId], references: [id])
  winnerGoals  Int      @default(0)
  topJson      Json?

  // estatísticas de top 10 do perfil: busca "horas em que o jogador X ficou no top" (topJson @> [{userId}])
  @@index([topJson(ops: JsonbPathOps)], type: Gin)
}

model Record {
  id       Int         @id @default(autoincrement())
  scope    RecordScope
  seasonId Int?
  season   Season?     @relation(fields: [seasonId], references: [id])
  userId   Int
  user     User        @relation(fields: [userId], references: [id])
  goals    Int
  setAt    DateTime    @default(now())

  @@unique([scope, seasonId])
}

model Title {
  id          Int      @id @default(autoincrement())
  seasonId    Int
  season      Season   @relation(fields: [seasonId], references: [id])
  teamId      Int
  team        Team     @relation(fields: [teamId], references: [id])
  competition String // "Série A", "Série B", "Série C"
  place       Int // 1 = campeão, 2 = vice
  createdAt   DateTime @default(now())

  @@index([teamId])
}

model Nerf {
  id         Int      @id @default(autoincrement())
  fromUserId Int
  from       User     @relation("NerfFrom", fields: [fromUserId], references: [id])
  toUserId   Int
  to         User     @relation("NerfTo", fields: [toUserId], references: [id])
  createdAt  DateTime @default(now())

  @@index([toUserId])
}

// Bloqueio entre jogadores (política de conteúdo gerado por usuário da Play Store): quem bloqueia
// deixa de ver as mensagens do bloqueado no chat. POST/DELETE /api/me/block/:nick.
model UserBlock {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation("BlockFrom", fields: [userId], references: [id])
  blockedId Int
  blocked   User     @relation("BlockTo", fields: [blockedId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, blockedId])
}

// Denúncia de jogador/mensagem (política de conteúdo gerado por usuário): o painel de admin lista
// as abertas e resolve (ignorar, apagar a mensagem, banir). `messageText` é a cópia da mensagem
// na hora da denúncia (a original pode ser apagada depois).
model Report {
  id           Int       @id @default(autoincrement())
  reporterId   Int
  reporter     User      @relation("ReportFrom", fields: [reporterId], references: [id])
  targetId     Int
  target       User      @relation("ReportTo", fields: [targetId], references: [id])
  messageId    Int?
  messageText  String?
  reason       String // "ofensa" | "spam" | "golpe" | "nick" | "foto" | "outro"
  details      String?
  status       String    @default("OPEN") // "OPEN" | "RESOLVED"
  resolution   String? // "ignorar" | "apagar" | "banir"
  resolvedById Int?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([status, createdAt])
  @@index([targetId])
}

// Chat: salas "geral" e "time:<slug>". Cor da mensagem = habilidade do nível 8.
model ChatMessage {
  id        Int      @id @default(autoincrement())
  room      String
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  text      String
  color     String?
  createdAt DateTime @default(now())

  @@index([room, id])
}

// Auditoria do painel de admin (/api/painel): toda ação (editar, gols, exp, ban…) fica registrada.
model AdminAction {
  id        Int      @id @default(autoincrement())
  adminId   Int
  admin     User     @relation("AdminActionBy", fields: [adminId], references: [id])
  targetId  Int?
  target    User?    @relation("AdminActionTo", fields: [targetId], references: [id])
  action    String // "editar" | "gols" | "exp" | "banir" | "desbanir"
  payload   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([targetId, createdAt])
}

// Cabeção (head soccer 1x1 ao vivo): histórico das partidas + antifraude (IP, gol por dia).
model CabecaoMatch {
  id          Int      @id @default(autoincrement())
  aId         Int
  bId         Int
  aTeamId     Int
  bTeamId     Int
  aIp         String
  bIp         String
  scoreA      Int
  scoreB      Int
  winnerId    Int?
  reason      String   // time | golden | wo
  seconds     Int
  goalAwarded Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([winnerId, createdAt])
  @@index([aId, createdAt])
  @@index([bId, createdAt])
}

// X1 (jogos 1x1 ao vivo: FutPrego e Futebol de Botão, um por dia): uma linha por partida de verdade (bot não
// grava). A tabela continua com o nome antigo (FutPregoMatch). Nasce PLAYING quando os dois pagam a aposta; se
// a API reiniciar no meio, vira CANCELED e o dinheiro volta (realtime/x1.js). lostMatchId/lostTeamId = onde o
// time do perdedor perdeu 1 gol. seasonId = temporada em que foi jogada (Ranking do X1).
model X1Match {
  id          Int       @id @default(autoincrement())
  game        String    @default("FUTPREGO") // FUTPREGO | BOTAO
  seasonId    Int?
  aId         Int
  bId         Int
  aTeamId     Int
  bTeamId     Int
  aIp         String
  bIp         String
  bet         Int
  status      String    @default("PLAYING") // PLAYING | FINISHED | CANCELED
  winnerId    Int?
  reason      String?   // gol | gol-contra | penaltis | tempo | wo | desistiu | empate | wo-cedo | reinicio
  turns       Int       @default(0)
  scoreA      Int       @default(0)
  scoreB      Int       @default(0)
  goalAwarded Boolean   @default(false)
  // revanche repetida (o vencedor ganhou do mesmo adversário na partida anterior dele): não vale gol nem gasta
  // uma das 10 partidas da hora de nenhum dos dois (dono, 15/09/2026; realtime/x1.js settle)
  repeated    Boolean   @default(false)
  lostMatchId Int?
  lostTeamId  Int?
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?

  @@index([aId, bId, createdAt], map: "FutPregoMatch_aId_bId_createdAt_idx")
  @@index([winnerId, createdAt], map: "FutPregoMatch_winnerId_createdAt_idx")
  @@index([lostMatchId], map: "FutPregoMatch_lostMatchId_idx")
  @@index([status], map: "FutPregoMatch_status_idx")
  @@index([seasonId, goalAwarded, winnerId])
  @@map("FutPregoMatch")
}

// VIP pago (PIX na Efí): uma compra = uma cobrança com txid NOSSO (único). Só vira PAID quando a própria
// cobrança está CONCLUIDA na Efí (nunca por valor/horário — lição do Rifa Express); o endToEndId do PIX
// é único, então o mesmo PIX nunca credita duas vezes. status: PENDING | PAID | EXPIRED | FAILED.
model VipPurchase {
  id          Int       @id @default(autoincrement())
  userId      Int
  user        User      @relation(fields: [userId], references: [id])
  packKey     String
  days        Int
  money       Int       @default(0) // saldo do jogo que vem junto (VIP_PACKS.money na hora da compra)
  amountCents Int
  txid        String    @unique
  status      String    @default("PENDING")
  pixCode     String?
  qrImage     String?
  expiresAt   DateTime
  e2eId       String?   @unique
  paidAt      DateTime?
  checkedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, status])
  @@index([status, createdAt])
}

// ─── Diretoria e contratações (decisões do dono, 13/09/2026) ────────────────
// Cargos: 1 Presidente (slot 0) + até 2 Diretores (slots 1–2). O @@unique([teamId, slot]) garante
// NO BANCO um presidente só por time e no máximo 2 diretores; userId @unique = um cargo por jogador.
model TeamRole {
  id     Int      @id @default(autoincrement())
  teamId Int
  team   Team     @relation(fields: [teamId], references: [id])
  userId Int      @unique
  user   User     @relation(fields: [userId], references: [id])
  role   String // "PRESIDENTE" | "DIRETOR"
  slot   Int // 0 = presidente; 1..2 = diretores
  since  DateTime @default(now())

  @@unique([teamId, slot])
}

// Proposta de contratação: o VIP sai do banco de quem propõe ao enviar e volta se não fechar
// (recusada, vencida em 48 h, cancelada ou quem propôs saiu da diretoria). Aceita = o jogador vai
// para o time, recebe o VIP e ganha contrato de 1 dia por VIP. status: PENDING | ACCEPTED |
// REFUSED | CANCELED | EXPIRED (a volta do VIP só acontece na troca de PENDING, uma vez).
model TransferOffer {
  id         Int       @id @default(autoincrement())
  teamId     Int
  team       Team      @relation("OfferTeam", fields: [teamId], references: [id])
  fromUserId Int
  fromUser   User      @relation("OfferFrom", fields: [fromUserId], references: [id])
  toUserId   Int
  toUser     User      @relation("OfferTo", fields: [toUserId], references: [id])
  fromTeamId Int? // time de onde o jogador saiu (gravado ao aceitar — "Movimentações")
  fromTeam   Team?     @relation("OfferFromTeam", fields: [fromTeamId], references: [id])
  vip        Int
  message    String?
  status     String    @default("PENDING")
  expiresAt  DateTime
  decidedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([toUserId, status])
  @@index([fromUserId, status])
  @@index([teamId, status])
  @@index([fromTeamId, status])
  @@index([status, expiresAt])
}

// Doação de VIP guardado entre colegas do mesmo time (histórico para conferir abusos).
model VipGift {
  id         Int      @id @default(autoincrement())
  fromUserId Int
  fromUser   User     @relation("GiftFrom", fields: [fromUserId], references: [id])
  toUserId   Int
  toUser     User     @relation("GiftTo", fields: [toUserId], references: [id])
  teamId     Int
  days       Int
  createdAt  DateTime @default(now())

  @@index([fromUserId, createdAt])
  @@index([toUserId, createdAt])
}

// Presença da Semana (login diário; decisões do dono, 13/09/2026 — números em LOGIN_PASS, rules.js):
// um resgate por dia do calendário de Brasília. O @@unique([userId, day]) garante NO BANCO que o prêmio
// do dia sai uma vez só (dois toques ao mesmo tempo = um resgate). step = dia do passe (1..7); week =
// semanas seguidas sem pular (da 2ª em diante o 7º dia dá 2 VIP); reward = o que foi entregue.
model LoginPass {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  day       Int // calendarDay (time.js): #1 = 12/09/2026
  step      Int
  week      Int
  reward    Json
  createdAt DateTime @default(now())

  @@unique([userId, day])
}

// Convites: VIP pago a quem convidou quando o convidado chega a um marco de gols (REFERRAL, rules.js).
// O @@unique([referredId, milestone]) garante NO BANCO que cada marco de cada convidado paga uma vez só.
model ReferralReward {
  id         Int      @id @default(autoincrement())
  referrerId Int
  referrer   User     @relation("RefEarner", fields: [referrerId], references: [id])
  referredId Int
  referred   User     @relation("RefFrom", fields: [referredId], references: [id])
  milestone  Int // gols da carreira do convidado (25, 50, 100, …)
  vip        Int
  side       String   @default("REFERRER") // REFERRER = quem convidou recebeu; REFERRED = o convidado recebeu (os dois ganham, dono 15/09/2026)
  createdAt  DateTime @default(now())

  @@unique([referredId, milestone, side])
  @@index([referrerId])
}

// Caixa de mensagens (pedido do dono, 15/09/2026; services/inbox.js): avisos dos admins e do jogo — compra
// aprovada, VIP/saldo recebidos, presentes (convite, doação, prêmio do X1), atualizações (uma linha por jogador).
model Message {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation("MsgTo", fields: [userId], references: [id])
  fromId    Int?
  from      User?     @relation("MsgFrom", fields: [fromId], references: [id])
  kind      String // ADMIN | AVISO | COMPRA | PRESENTE | PREMIO
  icon      String? // ícone da mensagem na lista (ex.: /ui/ico-crown_silver.png); null = ícone do tipo. No texto, [vip] [coin] etc. viram ícones (MsgText.tsx)
  title     String
  text      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}
