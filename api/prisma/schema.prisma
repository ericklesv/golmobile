// BRGOL — modelo de dados (PostgreSQL)
// Toda escrita de jogo passa pela API; o cliente nunca toca no banco.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Serie {
  A
  B
  C
}

enum KickKind {
  AUTO
  PENALTY
  FOUL
  TRAIL
  PARTY
  TERMO
  QUIZ
  MEMORIA
  QUALTIME
  ALVO
  STATS
  CABECAO
  CAMISAS
  HATTRICK
  FALTAPRO
}

enum SeasonStatus {
  ACTIVE
  FINISHED
}

enum RoundStatus {
  LIVE
  FINISHED
}

enum RecordScope {
  HOUR
  ROUND
  SEASON
}

model User {
  id           Int       @id @default(autoincrement())
  nick         String    @unique
  nickLower    String    @unique
  email        String    @unique
  passwordHash String
  gender       String    @default("M")
  bio          String?
  avatarUrl    String?   // /api/uploads/avatars/<id>.<ext>
  nickColor    String?   // cor do nick (chave da paleta em lib/items.js; habilidade "Mensagem com cores", lvl 8)
  isAdmin      Boolean   @default(false)
  bannedUntil  DateTime?
  createdAt    DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  lastIp       String? // último IP visto (cadastro/login/heartbeat) — painel de admin
  lastIpAt     DateTime?

  teamId Int
  team   Team @relation(fields: [teamId], references: [id])

  // Economia
  money     Int       @default(0) // R$ virtuais
  vipDays   Int       @default(0) // unidades de VIP no banco (1 unidade = 1 dia)
  vipUntil  DateTime?
  dexterity Int       @default(0) // destreza 0..30

  // Contadores de gols (espelham a tabela Goal para leitura rápida)
  goalsTotal  Int     @default(0)
  goalsSeason Int     @default(0)
  seasonId    Int?
  goalsRound  Int     @default(0)
  roundId     Int?
  goalsHour   Int     @default(0)
  hourKey     String?

  // Pontos de nível extras (minigames diários). Nível = goalsTotal + levelBonus.
  levelBonus  Int     @default(0)
  // Recorde de sequência no minigame Estatísticas
  statsBest   Int     @default(0)

  // Estatísticas por modo (acertos / tentativas)
  autoGoals    Int @default(0)
  penaltyGoals Int @default(0)
  penaltyTries Int @default(0)
  foulGoals    Int @default(0)
  foulTries    Int @default(0)
  trailGoals   Int @default(0)
  trailTries   Int @default(0)
  partyWins    Int @default(0)
  partyTries   Int @default(0)

  // Recargas (última execução de cada modo)
  lastAutoAt    DateTime?
  lastPenaltyAt DateTime?
  lastFoulAt    DateTime?
  lastTrailAt   DateTime?

  // Corrida da trilha em andamento (layout secreto + fase)
  trailState Json?

  goals       Goal[]
  activities  Activity[]
  nerfsGiven  Nerf[]     @relation("NerfFrom")
  nerfsTaken  Nerf[]     @relation("NerfTo")
  records     Record[]
  hourWins    HourResult[]
  dailyGames  DailyGame[]
  chatMessages ChatMessage[]
  items       UserItem[]
  shopLogs    ShopLog[]
  passwordResets PasswordReset[]
  adminActions AdminAction[] @relation("AdminActionBy")
  adminTargeted AdminAction[] @relation("AdminActionTo")

  @@index([teamId])
  @@index([goalsTotal])
}

// Minigames diários: 1 partida por jogador, por jogo, por dia (o dia vira à
// meia-noite de Brasília). `game` é texto para um minigame novo não pedir migração.
model DailyGame {
  id         Int       @id @default(autoincrement())
  userId     Int
  user       User      @relation(fields: [userId], references: [id])
  game       String // "TERMO"
  day        Int // nº do dia no calendário dos minigames (#1 = 12/09/2026)
  state      Json // estado do minigame (Termo: { guesses: string[] })
  won        Boolean   @default(false)
  reward     Json? // o que ganhou ao vencer (gol, pontos de nível)
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, game, day])
  @@index([game, day])
}

model Team {
  id             Int    @id @default(autoincrement())
  slug           String @unique
  name           String
  abbr           String
  state          String
  colorPrimary   String
  colorSecondary String
  stadium        String
  serie          Serie
  slogan         String?

  users       User[]
  homeMatches Match[]    @relation("HomeTeam")
  awayMatches Match[]    @relation("AwayTeam")
  standings   Standing[]
  goals       Goal[]
  titles      Title[]
  activities  Activity[]
}

// ─── Loja ───────────────────────────────────────────────────────────────────
// O catálogo de itens é estático em código (lib/items.js). Aqui só o que o
// jogador tem: item com validade (expiresAt), nível (Energia 1..5), se está
// equipado (chuteiras: só uma) e se já foi consumido (Caneleira: numa trilha).
model UserItem {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  itemKey   String // chave em lib/items.js (ENERGY, BOOST_AUTO, SHIN_GUARD, BOOT_*)
  level     Int       @default(1)
  equipped  Boolean   @default(false)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, itemKey])
  @@index([userId, expiresAt])
}

// Histórico da loja (toda compra: item, preço e moeda).
model ShopLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  itemKey   String
  price     Int
  currency  String // "money" | "vip"
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Recuperação de senha por e-mail: token de uso único (guardado como hash SHA-256) com validade.
model PasswordReset {
  id        Int       @id @default(autoincrement())
  token     String    @unique
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Season {
  id          Int          @id @default(autoincrement())
  number      Int          @unique
  startsAt    DateTime
  endsAt      DateTime?
  totalRounds Int
  status      SeasonStatus @default(ACTIVE)

  rounds    Round[]
  standings Standing[]
  goals     Goal[]
  records   Record[]
  titles    Title[]
}

model Round {
  id       Int         @id @default(autoincrement())
  seasonId Int
  season   Season      @relation(fields: [seasonId], references: [id])
  number   Int
  startsAt DateTime
  endsAt   DateTime
  status   RoundStatus @default(LIVE)
  topJson  Json? // top 10 artilheiros congelado no fechamento

  matches Match[]
  goals   Goal[]

  @@unique([seasonId, number])
  @@index([status, endsAt])
}

model Match {
  id         Int         @id @default(autoincrement())
  roundId    Int
  round      Round       @relation(fields: [roundId], references: [id])
  serie      Serie
  homeTeamId Int
  homeTeam   Team        @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId Int
  awayTeam   Team        @relation("AwayTeam", fields: [awayTeamId], references: [id])
  homeGoals  Int         @default(0)
  awayGoals  Int         @default(0)
  status     RoundStatus @default(LIVE)

  goals Goal[]

  @@index([roundId])
  @@index([homeTeamId])
  @@index([awayTeamId])
}

model Standing {
  id           Int    @id @default(autoincrement())
  seasonId     Int
  season       Season @relation(fields: [seasonId], references: [id])
  teamId       Int
  team         Team   @relation(fields: [teamId], references: [id])
  serie        Serie
  points       Int    @default(0)
  played       Int    @default(0)
  wins         Int    @default(0)
  draws        Int    @default(0)
  losses       Int    @default(0)
  goalsFor     Int    @default(0)
  goalsAgainst Int    @default(0)

  @@unique([seasonId, teamId])
  @@index([seasonId, serie])
}

model Goal {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  teamId    Int
  team      Team     @relation(fields: [teamId], references: [id])
  matchId   Int?
  match     Match?   @relation(fields: [matchId], references: [id])
  roundId   Int?
  round     Round?   @relation(fields: [roundId], references: [id])
  seasonId  Int?
  season    Season?  @relation(fields: [seasonId], references: [id])
  hourKey   String
  kind      KickKind
  money     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([hourKey, userId])
  @@index([roundId, userId])
  @@index([seasonId, userId])
  @@index([userId, kind])
  @@index([createdAt])
}

model Activity {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  teamId    Int
  team      Team     @relation(fields: [teamId], references: [id])
  kind      KickKind
  goal      Boolean
  text      String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([teamId, createdAt])
}

model HourResult {
  id           Int      @id @default(autoincrement())
  hourKey      String   @unique
  closedAt     DateTime @default(now())
  winnerUserId Int?
  winner       User?    @relation(fields: [winnerUserId], references: [id])
  winnerGoals  Int      @default(0)
  topJson      Json?
}

model Record {
  id       Int         @id @default(autoincrement())
  scope    RecordScope
  seasonId Int?
  season   Season?     @relation(fields: [seasonId], references: [id])
  userId   Int
  user     User        @relation(fields: [userId], references: [id])
  goals    Int
  setAt    DateTime    @default(now())

  @@unique([scope, seasonId])
}

model Title {
  id          Int      @id @default(autoincrement())
  seasonId    Int
  season      Season   @relation(fields: [seasonId], references: [id])
  teamId      Int
  team        Team     @relation(fields: [teamId], references: [id])
  competition String // "Série A", "Série B", "Série C"
  place       Int // 1 = campeão, 2 = vice
  createdAt   DateTime @default(now())

  @@index([teamId])
}

model Nerf {
  id         Int      @id @default(autoincrement())
  fromUserId Int
  from       User     @relation("NerfFrom", fields: [fromUserId], references: [id])
  toUserId   Int
  to         User     @relation("NerfTo", fields: [toUserId], references: [id])
  createdAt  DateTime @default(now())

  @@index([toUserId])
}

// Chat: salas "geral" e "time:<slug>". Cor da mensagem = habilidade do nível 8.
model ChatMessage {
  id        Int      @id @default(autoincrement())
  room      String
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  text      String
  color     String?
  createdAt DateTime @default(now())

  @@index([room, id])
}

// Auditoria do painel de admin (/api/painel): toda ação (editar, gols, exp, ban…) fica registrada.
model AdminAction {
  id        Int      @id @default(autoincrement())
  adminId   Int
  admin     User     @relation("AdminActionBy", fields: [adminId], references: [id])
  targetId  Int?
  target    User?    @relation("AdminActionTo", fields: [targetId], references: [id])
  action    String // "editar" | "gols" | "exp" | "banir" | "desbanir"
  payload   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([targetId, createdAt])
}

// Cabeção (head soccer 1x1 ao vivo): histórico das partidas + antifraude (IP, gol por dia).
model CabecaoMatch {
  id          Int      @id @default(autoincrement())
  aId         Int
  bId         Int
  aTeamId     Int
  bTeamId     Int
  aIp         String
  bIp         String
  scoreA      Int
  scoreB      Int
  winnerId    Int?
  reason      String   // time | golden | wo
  seconds     Int
  goalAwarded Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([winnerId, createdAt])
  @@index([aId, createdAt])
  @@index([bId, createdAt])
}
